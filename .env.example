# LocaShare Backend Configuration
# Copy this file to backend/.env (never commit real secrets).

# Database driver: "mysql" (XAMPP/LAMP) or "sqlite" (zero-config local/testing)
LOCASHARE_DB_DRIVER=mysql
LOCASHARE_DB_HOST=127.0.0.1
LOCASHARE_DB_PORT=3306
LOCASHARE_DB_NAME=locashare
LOCASHARE_DB_USER=root
LOCASHARE_DB_PASSWORD=
LOCASHARE_DB_CHARSET=utf8mb4

# Used when LOCASHARE_DB_DRIVER=sqlite
LOCASHARE_DB_SQLITE_PATH=backend/database/locashare.sqlite

# Application settings
LOCASHARE_APP_DEBUG=false
LOCASHARE_TIMEZONE=UTC
LOCASHARE_BASE_URL=https://locashare.example.com

# Security & Session settings
# Cookie Secure flag: "auto" (true over HTTPS), "true" (recommended in production), or "false" (local HTTP dev only)
LOCASHARE_COOKIE_SECURE=auto
LOCASHARE_COOKIE_SAMESITE=Strict
LOCASHARE_SESSION_TTL_SECONDS=2592000
LOCASHARE_PAIRING_TTL_SECONDS=300
LOCASHARE_MAX_PAYLOAD_BYTES=16384
# Comma-separated allowed CORS origins (leave empty for strict same-origin)
LOCASHARE_ALLOWED_ORIGINS=

# Status freshness thresholds
LOCASHARE_ONLINE_THRESHOLD_SECONDS=90
LOCASHARE_LOCATION_STALE_SECONDS=180
LOCASHARE_DASHBOARD_POLL_MS=10000

# Rate limiting
LOCASHARE_RATE_LIMIT_API_MAX=120
LOCASHARE_RATE_LIMIT_API_WINDOW=60
LOCASHARE_RATE_LIMIT_REGISTER_MAX=10
LOCASHARE_RATE_LIMIT_REGISTER_WINDOW=300
LOCASHARE_RATE_LIMIT_PAIR_MAX=10
LOCASHARE_RATE_LIMIT_PAIR_WINDOW=300
