# LocaShare Apache Configuration (.htaccess)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header through to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block direct access to internal directories and dotfiles
    RewriteRule ^(config|database|includes|logs|tests)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]

    # Route extensionless API paths to .php files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>
