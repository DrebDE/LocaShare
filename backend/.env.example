# LocaShare Environment Configuration Template
# Copy this file to backend/.env and adjust for your deployment.
# Do NOT commit real credentials or production secrets to version control.

# Database Driver: "sqlite" (zero-config local/single-node) or "mysql" (MySQL/MariaDB)
LOCASHARE_DB_DRIVER=sqlite
LOCASHARE_DB_SQLITE_PATH=backend/database/locashare.sqlite

# MySQL / MariaDB Settings (used when LOCASHARE_DB_DRIVER=mysql)
LOCASHARE_DB_HOST=127.0.0.1
LOCASHARE_DB_PORT=3306
LOCASHARE_DB_NAME=locashare
LOCASHARE_DB_USER=locashare_user
LOCASHARE_DB_PASSWORD=change_me_in_production
LOCASHARE_DB_CHARSET=utf8mb4

# Security & Pairing Settings
LOCASHARE_PAIRING_TTL_SECONDS=300
LOCASHARE_PAIRING_CODE_LENGTH=8
LOCASHARE_SESSION_TTL_SECONDS=2592000
# Cookie Secure flag: "auto" (true on HTTPS), "true" (recommended in production HTTPS), or "false"
LOCASHARE_COOKIE_SECURE=auto
LOCASHARE_COOKIE_SAMESITE=Strict
LOCASHARE_MAX_PAYLOAD_BYTES=16384
LOCASHARE_ALLOWED_ORIGINS=

# Rate Limiting
LOCASHARE_RATE_LIMIT_API_MAX=120
LOCASHARE_RATE_LIMIT_API_WINDOW=60
LOCASHARE_RATE_LIMIT_REGISTER_MAX=10
LOCASHARE_RATE_LIMIT_REGISTER_WINDOW=300
LOCASHARE_RATE_LIMIT_PAIR_MAX=10
LOCASHARE_RATE_LIMIT_PAIR_WINDOW=300

# Status Freshness Thresholds (in seconds)
# Online threshold is based on last_heartbeat_at; Location stale threshold is based on location_recorded_at
LOCASHARE_ONLINE_THRESHOLD_SECONDS=90
LOCASHARE_LOCATION_STALE_SECONDS=180

# Dashboard Polling Interval (in milliseconds)
LOCASHARE_DASHBOARD_POLL_MS=10000

# Dashboard Map Provider
# Options: esri_street (default, no API key), esri_hybrid (Satellite + street labels, no key),
#          esri_satellite (Satellite imagery, no key), osm (OpenStreetMap),
#          grid (Local Privacy Grid, 0 external requests),
#          google_roadmap / google_hybrid (optional, requires LOCASHARE_GOOGLE_MAPS_API_KEY)
LOCASHARE_MAP_DEFAULT_PROVIDER=esri_street
LOCASHARE_GOOGLE_MAPS_API_KEY=

# Application Settings
LOCASHARE_APP_DEBUG=false
LOCASHARE_TIMEZONE=UTC
LOCASHARE_BASE_URL=

# Optional Firebase Cloud Messaging (FCM HTTP v1) Push Alerts
# Leave blank to rely on built-in background alert syncing with zero Firebase config.
LOCASHARE_FCM_PROJECT_ID=
LOCASHARE_FCM_CLIENT_EMAIL=
LOCASHARE_FCM_PRIVATE_KEY=
